/* ---------------------------------------------------------------- DATABASE */
function isPg() {
    static $pg = null;
    if ($pg === null) $pg = (bool)preg_match('~^postgres(ql)?://~i', env('DATABASE_URL'));
    return $pg;
}

function db() {
    static $pdo = null;
    if ($pdo) return $pdo;
    $opt = [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC];
    if (isPg()) {
        $p = parse_url(env('DATABASE_URL'));
        $dsn = sprintf('pgsql:host=%s;port=%d;dbname=%s;sslmode=%s', $p['host'], $p['port'] ?? 5432, ltrim($p['path'], '/'), env('PGSSLMODE', 'prefer'));
        $pdo = new PDO($dsn, urldecode($p['user'] ?? ''), urldecode($p['pass'] ?? ''), $opt);
    } else {
        $path = env('DB_PATH');
        if (!$path) {
            $dir = (is_dir('/var/data') && is_writable('/var/data')) ? '/var/data' : __DIR__ . '/data';
            if (!is_dir($dir)) @mkdir($dir, 0775, true);
            $path = $dir . '/shop.sqlite';
        }
        $pdo = new PDO('sqlite:' . $path, null, null, $opt);
        $pdo->exec('PRAGMA journal_mode=WAL');
        $pdo->exec('PRAGMA busy_timeout=8000');
    }
    return $pdo;
}

function q($sql, $p = array()) { $s = db()->prepare($sql); $s->execute($p); return $s; }
function one($sql, $p = array()) { $r = q($sql, $p)->fetch(PDO::FETCH_ASSOC); return $r === false ? null : $r; }
function all($sql, $p = array()) { return q($sql, $p)->fetchAll(PDO::FETCH_ASSOC); }
function val($sql, $p = array()) { $v = q($sql, $p)->fetchColumn(); return $v === false ? null : $v; }

function insertId($sql, $p) {
    if (isPg()) return (int)q($sql . ' RETURNING id', $p)->fetchColumn();
    q($sql, $p);
    return (int)db()->lastInsertId();
}

function tx($fn) {
    $pdo = db();
    $pdo->exec(isPg() ? 'BEGIN' : 'BEGIN IMMEDIATE');
    try {
        $r = $fn();
        $pdo->exec('COMMIT');
        return $r;
    } catch (Throwable $e) {
        try { $pdo->exec('ROLLBACK'); } catch (Throwable $x) {}
        throw $e;
    }
}

function initDb() {
    static $done = false;
    if ($done) return;
    $done = true;
    $ai = isPg() ? 'SERIAL PRIMARY KEY' : 'INTEGER PRIMARY KEY AUTOINCREMENT';
    $st = [
        "CREATE TABLE IF NOT EXISTS users (id BIGINT PRIMARY KEY, username TEXT DEFAULT '', first_name TEXT DEFAULT '',
            balance BIGINT DEFAULT 0, total_spent BIGINT DEFAULT 0, orders_count INTEGER DEFAULT 0, referrer_id BIGINT,
            ref_earnings BIGINT DEFAULT 0, last_spin BIGINT DEFAULT 0, banned INTEGER DEFAULT 0, state TEXT DEFAULT '',
            joined_at BIGINT DEFAULT 0)",
        "CREATE TABLE IF NOT EXISTS products (id $ai, name TEXT, description TEXT DEFAULT '', price BIGINT,
            delivery_type TEXT DEFAULT 'Instant Key', duration TEXT DEFAULT 'Lifetime', demo_url TEXT DEFAULT '',
            active INTEGER DEFAULT 1, created_at BIGINT)",
        "CREATE TABLE IF NOT EXISTS items (id $ai, product_id INTEGER, content TEXT, sold INTEGER DEFAULT 0, order_id TEXT)",
        "CREATE INDEX IF NOT EXISTS idx_items_p ON items(product_id, sold)",
        "CREATE TABLE IF NOT EXISTS orders (id TEXT PRIMARY KEY, user_id BIGINT, product_id INTEGER, product_name TEXT,
            amount BIGINT, content TEXT, status TEXT DEFAULT 'completed', created_at BIGINT)",
        "CREATE INDEX IF NOT EXISTS idx_orders_u ON orders(user_id, created_at)",
        "CREATE TABLE IF NOT EXISTS deposits (id TEXT PRIMARY KEY, user_id BIGINT, amount BIGINT, status TEXT DEFAULT 'pending',
            proof TEXT DEFAULT '', via TEXT DEFAULT '', created_at BIGINT, expires_at BIGINT, paid_at BIGINT DEFAULT 0)",
        "CREATE TABLE IF NOT EXISTS tickets (id $ai, user_id BIGINT, message TEXT, status TEXT DEFAULT 'open', created_at BIGINT)",
        "CREATE TABLE IF NOT EXISTS notify (user_id BIGINT, product_id INTEGER, PRIMARY KEY (user_id, product_id))",
        "CREATE TABLE IF NOT EXISTS reviews (id $ai, body TEXT)",
        "CREATE TABLE IF NOT EXISTS settings (k TEXT PRIMARY KEY, v TEXT)",
        "CREATE TABLE IF NOT EXISTS updates_seen (id BIGINT PRIMARY KEY)",
    ];
    foreach ($st as $s) db()->exec($s);
}

function setting($k, $d = '') { $v = val('SELECT v FROM settings WHERE k=?', [$k]); return $v === null ? $d : (string)$v; }
function setSetting($k, $v) { q('INSERT INTO settings(k,v) VALUES(?,?) ON CONFLICT(k) DO UPDATE SET v=excluded.v', [$k, $v]); }

/* ----------------------------------------------------------------- HELPERS */
function e($s) { return htmlspecialchars((string)$s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); }
function money($c) { return CUR . number_format(((int)$c) / 100, 2); }
function toCents($s) {
    $s = str_replace([',', ' ', CUR, '$', '₹'], ['.', '', '', '', ''], trim((string)$s));
    if (!preg_match('/^\d+(\.\d{1,2})?$/',$s)) return null;
    return (int)round(((float)$s) * 100);
}
function fdate($t) { return date('Y-m-d H:i', (int)$t); }
function normUrl($s) {
    $s = trim($s);
    if ($s === '') return '';
    if (preg_match('~^https?://~i', $s)) return $s;
    return 'https://t.me/' . ltrim($s, '@/');
}
function cut($s, $n) { return mb_strlen($s) > $n ? mb_substr($s, 0, $n - 1) . '…' : $s; }
function isAdmin($uid) { return ADMIN_ID && (int)$uid === ADMIN_ID; }

/* ---------------------------------------------------------- TELEGRAM CLIENT */
function tg($method, $p = array()) {
    foreach ($p as $k => $v) if (is_array($v)) $p[$k] = json_encode($v, JSON_UNESCAPED_UNICODE);
    $ch = curl_init(TG_API . '/bot' . BOT_TOKEN . '/' . $method);
    curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_POSTFIELDS => $p, CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 25, CURLOPT_CONNECTTIMEOUT => 10]);
    $r = curl_exec($ch);
    $err = curl_error($ch);
    curl_close($ch);
    if ($r === false) { error_log("tg $method curl error:$err"); return null; }
    $j = json_decode($r, true);
    if (!is_array($j) || empty($j['ok'])) error_log("tg $method failed:$r");
    return is_array($j) ? $j : null;
}

function bot($method, $p = array()) {
    return tg($method, $p);
}

function kb($rows) { return ['inline_keyboard' => $rows]; }
function b($text, $cb) { return ['text' => $text, 'callback_data' => $cb]; }
function ub($text, $url) { return ['text' => $text, 'url' => $url]; }

function send($chat, $text, $kb = null) {
    $p = ['chat_id' => $chat, 'text' => $text, 'parse_mode' => 'HTML', 'disable_web_page_preview' => true];
    if ($kb) $p['reply_markup'] = $kb;
    return tg('sendMessage', $p);
}

function show($c, $text, $kb = null) {
    if (!empty($c['mid'])) {
        $p = ['chat_id' => $c['chat'], 'message_id' => $c['mid'], 'text' => $text, 'parse_mode' => 'HTML', 'disable_web_page_preview' => true];
        if ($kb) $p['reply_markup'] = $kb;
        $r = tg('editMessageText', $p);
        if ($r && !empty($r['ok'])) return;
        if ($r && strpos((string)($r['description'] ?? ''), 'not modified') !== false) return;
    }
    send($c['chat'], $text, $kb);
}

function clearKb($c) {
    if (!empty($c['mid'])) tg('editMessageReplyMarkup', ['chat_id' => $c['chat'], 'message_id' => $c['mid'], 'reply_markup' => ['inline_keyboard' => []]]);
}

function cbAnswer($c, $text = '', $alert = false) {
    static $done = [];
    if (empty($c['cq']) || isset($done[$c['cq']])) return;
    $done[$c['cq']] = true;
    $p = ['callback_query_id' => $c['cq']];
    if ($text !== '') { $p['text'] = $text; $p['show_alert'] = $alert ? 'true' : 'false'; }
    tg('answerCallbackQuery', $p);
}

function botUsername() {
