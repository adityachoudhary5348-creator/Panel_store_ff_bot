function getUser($id) { return one('SELECT * FROM users WHERE id=?', [(int)$id]); }
function setState($uid, $s) { q('UPDATE users SET state=? WHERE id=?', [$s, (int)$uid]); }

function touchUser($from, $ref) {
    $id = (int)$from['id'];
    $un = (string)($from['username'] ?? '');
    $fn = trim((string)($from['first_name'] ?? ''));
    $u = getUser($id);
    if (!$u) {
        $refId = ($ref && $ref !== $id && getUser($ref)) ? $ref : null;
        q('INSERT INTO users(id,username,first_name,joined_at,referrer_id) VALUES(?,?,?,?,?) ON CONFLICT(id) DO NOTHING',
            [$id, $un, $fn, time(), $refId]);
        $u = getUser($id);
        if (!isAdmin($id)) adminNotify('👤 <b>New user</b>: ' . e($fn) . ($un ? ' @' . e($un) : '') . " (<code>$id</code>)");
        if ($refId) send($refId, '🎉 <b>' . e($fn) . '</b> joined using your referral link! You will earn ' . REF_PERCENT . '% on their deposits.');
    } elseif ($u['username'] !== $un || $u['first_name'] !== $fn) {
        q('UPDATE users SET username=?, first_name=? WHERE id=?', [$un, $fn, $id]);
        $u['username'] = $un; $u['first_name'] = $fn;
    }
    return $u;
}

